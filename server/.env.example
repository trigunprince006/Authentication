# ------------------------------------------------------------
# Copy this file, rename the copy to ".env" (no .example),
# and paste your own MongoDB Atlas connection string below.
#
# The .env file holds secrets. Never put it on GitHub and never
# paste the connection string directly into a .js file.
# ------------------------------------------------------------

MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/logindemo?retryWrites=true&w=majority
PORT=5000
